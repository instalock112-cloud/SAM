					if hum and espObjects[plr] then
						espObjects[plr].hpLbl.Text = "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
					end
				end
			end
		end)
	else
		if espConn then espConn:Disconnect() espConn = nil end
		for _, obj in pairs(espObjects) do if obj.bg then obj.bg:Destroy() end end
		espObjects = {}
	end
end)

